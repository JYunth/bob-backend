# .env.example - Example environment variables for Bob Backend

# Google AI API Key (Required)
# Get yours from Google AI Studio or Google Cloud
GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY

# Google Gemini Model Name (Required)
# Example: gemini-1.5-flash, gemini-2.0-flash
GEMINI_MODEL=gemini-2.0-flash

# Baxus API URL (Required)
BAXUS_API_URL=https://services.baxus.co/api

# Server Port (Optional)
# Default is 3000 if not specified
PORT=3000